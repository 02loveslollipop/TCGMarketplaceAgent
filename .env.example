# Root .env is ONLY for one-shot provisioning; never mount it into runtime services.
EXTERNAL_JDBC_POSTGRES_URI_ADMIN=postgresql://administrator:CHANGE_ME@host/database
OPENAI_API_KEY=
MISTRAL_API_KEY=
APIFY_TOKEN=
APIFY_API_KEY=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8080
# Sliding-session absolute lifetime and post-expiry refresh window.
MAX_SESSION_HOURS=168
REFRESH_GRACE_SECONDS=86400
